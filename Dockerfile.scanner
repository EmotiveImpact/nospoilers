FROM node:22-bookworm-slim AS build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY src ./src
COPY tsup.scanner.config.ts ./
RUN npx tsup --config tsup.scanner.config.ts

FROM node:22-bookworm-slim
WORKDIR /parser
RUN groupadd --gid 65532 scanner \
    && useradd --uid 65532 --gid 65532 --create-home --shell /usr/sbin/nologin scanner
COPY --from=build /build/dist-parser ./
USER scanner
ENTRYPOINT ["timeout", "--signal=KILL", "120s", "node", "--max-old-space-size=512", "/parser/scanner-child.mjs"]
