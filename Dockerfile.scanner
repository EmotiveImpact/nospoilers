FROM node:22-bookworm-slim AS build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY src ./src
COPY tsup.scanner.config.ts ./
RUN npx tsup --config tsup.scanner.config.ts

FROM node:22-bookworm-slim
WORKDIR /parser
RUN apt-get update \
    && apt-get install -y --no-install-recommends sudo \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 scanner \
    && useradd --uid 65532 --gid 65532 --create-home --shell /usr/sbin/nologin scanner \
    && groupadd --gid 65533 nospoilers-parser \
    && useradd --uid 65533 --gid 65533 --create-home --shell /bin/bash nospoilers-parser \
    && printf '%s\n' 'scanner ALL=(nospoilers-parser) NOPASSWD: ALL' > /etc/sudoers.d/nospoilers-parser \
    && chmod 0440 /etc/sudoers.d/nospoilers-parser \
    && visudo -cf /etc/sudoers.d/nospoilers-parser
COPY --from=build /build/dist-parser ./
USER scanner
ENTRYPOINT ["timeout", "--signal=KILL", "120s", "node", "--max-old-space-size=512", "/parser/scanner-child.mjs"]
