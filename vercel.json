{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "codex/website-docs-completion": false
    }
  },
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{.vercel-runtime/**,src/server/schema.sql}",
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/jobs",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
