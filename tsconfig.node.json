{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "api/**/*.ts",
    "vite.config.ts",
    "src/plugin.ts",
    "src/cli.ts",
    "src/receipt.ts",
    "src/release-diff.ts",
    "src/policy.ts",
    "src/scanner/**/*.ts",
    "src/server/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
