# Copy to .env and fill in after you create the GitHub App (see README).

PORT=4347
APP_BASE_URL=http://127.0.0.1:4347

# Embedded Postgres (default). For Docker: postgres://nospoilers:nospoilers@127.0.0.1:5433/nospoilers
DATABASE_URL=pglite://./data/nospoilers
# Vercel Marketplace Neon with a NEON_ prefix. The pooled URL takes
# precedence on the web runtime. Set the unpooled value as DATABASE_URL on a
# persistent worker so LISTEN and migrations use a direct session connection.
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=nospoilers

# Internal Artifact Leads desk. Generate a long random ADMIN_TOKEN.
# GITHUB_DISCOVERY_TOKEN is optional but raises public API limits from 60 to 5,000 requests/hour.
ADMIN_GITHUB_LOGIN=EmotiveImpact
ADMIN_TOKEN=
GITHUB_DISCOVERY_TOKEN=

# Optional fine-grained PAT for ONLY EmotiveImpact/nospoilers-throwaway
# (Administration + Contents write). Never a classic repo PAT.
GITHUB_PROOF_TOKEN=

# Optional. Must be set and at least 32 characters when DATABASE_URL is Neon/Postgres
# or APP_BASE_URL is https. Must not equal GITHUB_WEBHOOK_SECRET.
SESSION_SECRET=

# Optional HMAC key for signed scan receipts. Falls back to SESSION_SECRET.
# Development signer only; production should use KMS.
RECEIPT_SECRET=

HEAVY_CONCURRENCY=4
LIGHT_CONCURRENCY=20
MAX_ASSET_BYTES=83886080
POLL_INTERVAL_MS=3600000
# Recovery check only. API routes wake the worker immediately when they enqueue work.
WORKER_INTERVAL_MS=900000
JOB_MAX_ATTEMPTS=5
JOB_STALE_MS=300000
# Hosted POST /api/scan per address per window. 0 disables the limiter.
SCAN_RATE_LIMIT=60
SCAN_RATE_WINDOW_MS=3600000
# GitHub OAuth start and callback per address. 0 disables.
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_MS=3600000
# Owner Artifact Leads discover/inspect/rescan per address. 0 disables.
DISCOVERY_RATE_LIMIT=20
DISCOVERY_RATE_WINDOW_MS=3600000

# Optional. Checkout, portal, and Stripe webhooks stay 503 until all six are set.
# Test-mode keys only unless you intend to charge. Never commit live secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# Optional. Watch email save works without these. Test and send stay 503
# until both are set. From is the host mailbox, never a customer address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Process role for a production split. all (default) serves HTTP and claims
# jobs in one process. web serves API + built UI and wakes jobs on request
# (Vercel). worker claims jobs on a long-lived process and does not bind HTTP.
# Recovery stays 15 min.
# NOSPOILERS_ROLE=all

# Hosted worker only. `worker:hosted` refuses to start unless an isolated
# executor, immutable image reference and actual clean staging scan all pass.
# Use container only where the worker owns a local daemon and mount namespace.
# Use vercel-sandbox for the Railway -> Vercel Sandbox deployment. The image
# must be in the authenticated Vercel project's VCR and pinned by digest.
# NOSPOILERS_SCANNER_MODE=vercel-sandbox
# NOSPOILERS_SCANNER_IMAGE=nospoilers-scanner@sha256:<64 hex characters>
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# Leave DOCKER_HOST unset in either hosted mode.
# Select the notification path included in hosted acceptance. Slack uses each
# workspace's encrypted webhook; Resend also requires the two RESEND values.
# NOSPOILERS_HOSTED_NOTIFICATION_PROVIDER=resend

# Optional. Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/jobs.
# CRON_SECRET=
# Built SPA directory for `npm run build` + `npm run host`.
# NOSPOILERS_UI_ROOT=dist
